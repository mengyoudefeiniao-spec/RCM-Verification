<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="iq.digitalration.faceverify"
    android:versionCode="8"
    android:versionName="1.7-offline">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="33" />

    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <!-- NFC 读 ICAO 9303 芯片：没有 NFC 的机器仍然可以用光学识别 -->
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.NFC" />
    <!-- 本机生物识别登录：API 28+ 用 BiometricPrompt 必须声明 USE_BIOMETRIC（普通权限，安装即授予）。
         没有它会在 authenticate() 直接抛 SecurityException（v2.5 首版真机就撞到了）。
         API 24—27 的系统锁屏确认走 USE_FINGERPRINT（仅旧系统需要，新系统上不生效）。 -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT"
        android:maxSdkVersion="27" />

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:largeHeap="true"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".VerifyActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".CompareActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".CameraDiagActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 60 秒动态码：8 位码 + 可扫的二维码 + 倒计时（v2.7） -->
        <activity
            android:name=".CodeActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 离线花名册查看/搜索（v2.7） -->
        <activity
            android:name=".RosterActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".EvalActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 证件核验：卡背 OCR + NFC 芯片读取（NFC 用 reader mode，不需要 intent-filter） -->
        <activity
            android:name=".IdCardActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 前置摄像头人脸登录：活体挑战 + 端侧 1:1 比对 + 令牌签发（v2.8）。
             系统 BiometricPrompt 不能指定"只要人脸"，既录了指纹又录了 2D 人脸的机器一律先弹指纹，
             所以这条路必须自己在 App 内开前置相机做。 -->
        <activity
            android:name=".FaceLoginActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 技术验证实验室：逐条 TV 自测 + 报告导出（v2.5） -->
        <activity
            android:name=".LabActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 报告 ZIP 分享：本工程没有 androidx，用自建只读 provider 代替 FileProvider。
             authorities 由 tools/build.ps1 按实际包名重写（lite 包必须不同，否则两包不能共存）。 -->
        <provider
            android:name=".ReportProvider"
            android:authorities="iq.digitalration.faceverify.reports"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
